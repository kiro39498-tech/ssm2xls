# Application Settings
APP_NAME=SSMS2XLS
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO

# SQLite Metadata Database
# Path relative to backend root or absolute path
SQLITE_DB_PATH=data/metadata.db
SQLITE_BUSY_TIMEOUT_MS=30000

# SQL Server Target Connection (Default local instance: MSSQLSERVER)
SQL_SERVER=localhost
SQL_DATABASE=master
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=true
SQL_ENCRYPT=true
# TrustServerCertificate defaults to false for security.
# Set to true only in local development when SQL Server uses a self-signed development certificate.
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT=15
SQL_QUERY_TIMEOUT=30

